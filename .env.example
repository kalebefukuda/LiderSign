# Copie para .env e ajuste. Nunca versione o .env (ISO 27001 A.8.24).
# No Docker (docker compose up --build) tudo já vem com valores de demo: este arquivo serve para trocar algum
# valor ou para rodar fora do Docker.
#
# Em desenvolvimento, o Vite (porta 3000) faz proxy de /v1, /demo-host e /health para o Nest (porta 4000).
# No Docker, o Nest serve a API e o site juntos na porta 3000.

# ---------- App (Nest) ----------
DATABASE_URL=postgresql://lidersign:lidersign@localhost:5432/lidersign
# 4000 em desenvolvimento; o Docker usa 3000
PORT=4000
# Chave de parceiro da LíderHub. Gere com: openssl rand -hex 32
PARTNER_API_KEY=troque-por-uma-chave-longa-e-aleatoria
# Endereço público do site: vai nos links do WhatsApp. Para abrir no celular, use a URL do túnel (infra/tunnel.md)
WEB_PUBLIC_URL=http://localhost:3000
# Build do React que o Nest serve (vazio = apps/web/dist)
WEB_DIST_DIR=
STORAGE_DIR=./data/storage
CERT_DIR=./data/certs
# Senha do certificado de selagem (gerado na primeira execução; em produção, e-CNPJ A1 no cofre)
SEAL_CERT_PASSPHRASE=troque-esta-senha
# Carimbo do tempo RFC 3161. Deixe vazio para desligar.
TSA_URL=https://freetsa.org/tsr
# Hosts que podem receber webhooks (proteção contra SSRF)
WEBHOOK_ALLOWED_HOSTS=localhost,127.0.0.1

# WhatsApp: simulator (padrão, sem conta) ou cloud_api (oficial da Meta)
WHATSAPP_PROVIDER=simulator
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v23.0

# IA para transformar contrato em modelo (opcional; sem chave usa regras locais)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Modo demonstração: libera o simulador, o reset e o módulo /demo-host (o "back da LíderHub" da demo)
DEMO_MODE=true
DEMO_TENANT_ID=escritorio-demo

# ---------- MCP (agente) ----------
# Com ou sem /v1. Docker: http://localhost:3000/v1 · desenvolvimento: http://localhost:4000
LIDERSIGN_API_URL=http://localhost:4000
LIDERSIGN_TENANT_ID=escritorio-demo
