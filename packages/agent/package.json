{
    "name": "@lidersign/agent",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "mcp": "node dist/mcp-stdio.js",
        "mcp:http": "node dist/mcp-http.js",
        "test": "node --test test/*.test.mjs"
    },
    "dependencies": {
        "@lidersign/shared": "workspace:*",
        "@mastra/core": "^1.78.0",
        "@mastra/mcp": "^1.18.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/node": "^22.19.1",
        "typescript": "5.9.3"
    },
    "description": "Agente LíderSign: IA que transforma contrato em modelo e servidor MCP com as ferramentas de assinatura.",
    "files": [
        "dist"
    ]
}
