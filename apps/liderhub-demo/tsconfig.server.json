{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "outDir": "dist/server",
        "rootDir": "server",
        "types": ["node"]
    },
    "include": ["server"]
}
