{
    "name": "@lidersign/liderhub-demo",
    "version": "0.1.0",
    "private": true,
    "description": "Simulação da LíderHub: um parceiro que integra o LíderSign só pela API.",
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.json --noEmit && vite build && tsc -p tsconfig.server.json",
        "dev": "node --watch --import tsx server/main.ts & vite --port 3001 --strictPort",
        "start": "node dist/server/main.js",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
    },
    "dependencies": {
        "express": "5.2.1",
        "helmet": "8.3.0"
    },
    "devDependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@lidersign/shared": "workspace:*",
        "@lidersign/ui": "workspace:*",
        "@tailwindcss/vite": "4.3.3",
        "@types/express": "^5.0.6",
        "@types/node": "^22.19.1",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "5.2.0",
        "lucide-react": "^1.60.0",
        "qrcode": "1.5.4",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router": "7.18.4",
        "sonner": "^2.0.8",
        "tailwindcss": "4.3.3",
        "tsx": "^4.20.6",
        "typescript": "5.9.3",
        "vite": "7.3.7"
    }
}
