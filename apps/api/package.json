{
    "name": "@lidersign/api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "prisma generate && nest build",
        "dev": "nest start --watch",
        "start": "node dist/main.js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
        "db:reset": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate reset --force"
    },
    "dependencies": {
        "@lidersign/agent": "workspace:*",
        "@lidersign/shared": "workspace:*",
        "@nestjs/common": "11.2.7",
        "@nestjs/core": "11.2.7",
        "@nestjs/platform-express": "11.2.7",
        "@nestjs/serve-static": "5.0.5",
        "@nestjs/throttler": "6.7.1",
        "@prisma/adapter-pg": "6.19.3",
        "@prisma/client": "6.19.3",
        "@signpdf/placeholder-pdf-lib": "4.0.0",
        "@signpdf/signer-p12": "4.0.0",
        "@signpdf/signpdf": "4.0.0",
        "@signpdf/utils": "4.0.0",
        "express": "5.2.1",
        "helmet": "8.3.0",
        "mammoth": "1.13.0",
        "node-forge": "1.4.0",
        "pdf-lib": "1.17.1",
        "pdf-parse": "2.4.5",
        "pdfmake": "0.2.23",
        "pg": "^8.23.1",
        "qrcode": "1.5.4",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@nestjs/cli": "11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@types/express": "^5.0.6",
        "@types/multer": "^2.3.0",
        "@types/node": "^22.19.1",
        "@types/node-forge": "^1.3.14",
        "@types/pdfmake": "0.2.13",
        "@types/qrcode": "^1.5.6",
        "prisma": "6.19.3",
        "typescript": "5.9.3"
    }
}
